{
  "name": "mcp-server-eventkit",
  "version": "0.1.3",
  "type": "module",
  "description": "MCP Server for native EventKit integration - manage Reminders.app from Claude",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build:swift": "bash src/swift-bridge/build.sh",
    "build:binary": "bun build --compile --outfile build/mcp-eventkit src/index.ts",
    "build:pkg": "./installer/build-pkg.sh",
    "build": "bun run build:swift && bun run build:binary",
    "test": "bun test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "keywords": [
    "mcp",
    "eventkit",
    "reminders",
    "calendar",
    "macos",
    "apple",
    "claude",
    "model-context-protocol"
  ],
  "author": "Alejandro Sánchez Rodríguez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asanchezr/mcp-server-eventkit.git"
  },
  "bugs": {
    "url": "https://github.com/asanchezr/mcp-server-eventkit/issues"
  },
  "homepage": "https://github.com/asanchezr/mcp-server-eventkit#readme",
  "engines": {
    "bun": ">=1.0.0"
  }
}
